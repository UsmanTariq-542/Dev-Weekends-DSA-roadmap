class Solution {
public:
    double solve(double x,long n){
        if(x==0.0) return 0.0;

        if(n==0) return 1;
        if(n==1) return x;

        if(n>1){ // positive case 

            if(n%2==0){ // even
                return solve(x*x,n/2);
            }

            else{  // odd
                return x * solve(x*x,(n-1)/2);
            }
                
        }
        else{  // n is negative case
            return solve(1/x,-n);
        }
    }


    double myPow(double x, int n) {
        return solve(x,long(n));
        
    }
};