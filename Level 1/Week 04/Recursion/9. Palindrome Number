class Solution {
public:
    bool solve(string n,int start,int end){
        if(end-start+1<=1) return true;

        if(n[start]==n[end]){
            return solve(n,start+1,end-1);
        }
        return false;

    }

    bool isPalindrome(int x) {
        if(x<0) return false;   // neg no cant be a palindrome in any case.

        string n = to_string(x);
        return solve(n,0,n.size()-1);
    }
};