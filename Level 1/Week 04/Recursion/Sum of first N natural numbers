#include <iostream>
using namespace std;

int findSum(int n){
    if(n<=1) return n;
    
    return n + findSum(n-1);
}

int main() {
    // sum of first n natural numbers recursively.
    int n;
    cout<<"Enter value of n: ";
    cin>>n;
    
    cout<<"Sum of first "<<n<<" natural numbers is: "<< findSum(n);
    
}
