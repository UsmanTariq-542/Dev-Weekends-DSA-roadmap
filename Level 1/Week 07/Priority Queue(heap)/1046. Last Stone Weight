class Solution {
public:
    int lastStoneWeight(vector<int>& stones) {
        priority_queue<int> pq; // maxheap by default in cpp

        for(int& stone: stones){
            pq.push(stone);
        }

        while(pq.size()>1){
            int first = pq.top();
            pq.pop();

            int second = pq.top();
            pq.pop();

            if(first !=second){
                int newStone = abs(first-second);
                pq.push(newStone);
            }
        }

        return pq.empty()? 0: pq.top();
    }
};
