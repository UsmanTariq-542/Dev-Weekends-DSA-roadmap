class Solution {
public:
    bool isValid(string s) {
        stack<char> st;
        for(char& ch:s){
            if(ch=='('){
                st.push(ch);
            }
            else if(ch=='{'){
                st.push(ch);
            }
            else if(ch=='['){
                st.push(ch);
            }
            else{   // ),},] hi honga
                if(st.empty()) return false;
                if(ch==')' && st.top()!='(') {
                    return false;
                }
                else if(ch=='}' && st.top()!='{'){
                    return false;
                }
                else if(ch==']' && st.top()!='['){
                    return false;
                }
                st.pop();
            }
        }

        return st.empty();
        
    }
};