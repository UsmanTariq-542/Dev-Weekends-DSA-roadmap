// Approach 1: Simulation using Queue + Stack
class Solution {
public:
    int countStudents(vector<int>& students, vector<int>& sandwiches) {
        queue<int> que;
        stack<int> st;

        for(int& std:students){
            que.push(std);
        }

        int size = sandwiches.size();
        for(int i=size-1;i>=0;i--){
            st.push(sandwiches[i]);
        }

        int rejection=0, eaters=0;
        while(rejection<que.size()){
            if(que.front()==st.top()){  // match what student wants
                que.pop();
                st.pop();
                eaters++;
                rejection=0;
            }
            else{
                int front = que.front();
                que.pop();
                que.push(front);
                rejection++;
            }
        }

        return students.size()-eaters;
    }
};

// Approach 2: Better - no extra space, count-based
class Solution {
public:
    int countStudents(vector<int>& students, vector<int>& sandwiches) {
        int std_0=0,std_1=0;
        for(int& s:students){
            if(s==1) std_1++;
            else std_0++;
        }
        
        int size = sandwiches.size();
        for(int i=0;i<size;i++){
            if(sandwiches[i]==1 && std_1>0){
                std_1--;
            }
            else if(sandwiches[i]==0 && std_0>0){
                std_0--;
            }
            else{
                return size-i;
            }
        }

        return 0;
    }
};
