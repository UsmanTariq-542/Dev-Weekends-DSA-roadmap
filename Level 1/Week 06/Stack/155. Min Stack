class MinStack {
public:
    stack<pair<int,int>> st;
    MinStack() {

    }
    
    void push(int value) {
        if(st.empty()){
            st.push({value,value});
        }
        else{
            int minval= min(value,st.top().second);
            st.push({value,minval});
        }
    }
    
    void pop() {
        if(!st.empty()){
            st.pop();
        }
    }
    
    int top() {
        if(!st.empty()){
            return st.top().first;
        }

        return INT_MIN;
    }
    
    int getMin() {
        if(!st.empty()){
            return st.top().second;
        }

        return INT_MIN;
    }
};

