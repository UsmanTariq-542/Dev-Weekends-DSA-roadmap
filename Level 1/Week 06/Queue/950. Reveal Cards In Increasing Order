class Solution {
public:
    vector<int> deckRevealedIncreasing(vector<int>& deck) {
        int n = deck.size();
        vector<int> result(n,0);

        sort(begin(deck),end(deck));
        bool skip = false;
        int i=0, j=0;  // i deck k lea and j result p traverse k lea

        while(i<n){
            if(result[j]==0){
                if(skip==false){
                    result[j]=deck[i++];
                }
                
                skip = !skip;  // alternate krna k lea
            }

            j=(j+1)%n;
        }

        return result;

    }
};

