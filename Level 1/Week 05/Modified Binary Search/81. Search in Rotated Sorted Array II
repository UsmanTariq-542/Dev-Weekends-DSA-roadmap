class Solution {
public:
    int findPivot(vector<int>& nums, int left, int right){
        // skip duplicates first
        while(left<right && nums[left]==nums[left+1]) left++;
        while(left<right && nums[right]==nums[right-1]) right--;

        while(left<right){
            int mid = left+(right-left)/2;
            if(nums[mid]>nums[right]) left=mid+1;
            else right=mid;
        }

        return left;
    }

    bool binarySearch(vector<int>& nums, int left, int right,int target){
        while(left<=right){
            int mid = left+(right-left)/2;
            if(nums[mid]==target) return true;
            else if(nums[mid]>target) right=mid-1;
            else left=mid+1;
        }

        return false;
    }

    bool search(vector<int>& nums, int target) {
        int left=0, right=nums.size()-1;

        
        int pivot=findPivot(nums,left,right);
        bool leftside  = binarySearch(nums,0,pivot-1,target);
        if(leftside) return true;

        bool rightside = binarySearch(nums,pivot,nums.size()-1,target);

        if(rightside) return true;
        
        return false;
    }
};