class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {

        int largest = *max_element(begin(nums),end(nums));
        int smallest = *min_element(begin(nums),end(nums));
        if(largest-smallest+1 == nums.size()) return {}; // empty vector

        vector<int> result;

        unordered_set<int> st;
        st.insert(begin(nums),end(nums));
        

        for(int i=smallest;i<=largest;i++){  
            if(st.find(i)==st.end()) result.push_back(i);
        }

        return result;
    }
};